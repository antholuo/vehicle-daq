#
# Custome CAN message config file
# Raw IMU data with timestamps.
#
# Created on: March 22, 2025
#   Auther: Hardy Yu

#
# Data acquisition timestamp in the bus shared time base.
# The value is expressed as a 32-bit word and the bit resolution is 25 μs.
#
uint32 timestamp

#
# Linear acceleration samples in g.
# The samples are represented in the body frame, the axes are ordered as follows:
#   1. linear acceleration along X (forward positive)
#   2. linear acceleration along Y (right positive)
#   3. linear acceleration along Z (down positive)
#
int16[3] accelerometer_latest             # Latest sample, g

#
# Angular velocity samples in dps.
# The samples are represented in the body frame, the axes are ordered as follows:
#   1. angular velocity around X (roll rate)
#   2. angular velocity around Y (pitch rate)
#   3. angular velocity around Z (yaw rate)
#
int16[3] rate_gyro_latest                 # Latest sample, dps

#
# Magnetometer data samples in micro-tesla.
#
int16[3] magnetometer_latest                 # Latest sample, micro-tesla

bool    accel_data_valid
bool    gyro_data_valid
bool    mag_data_valid